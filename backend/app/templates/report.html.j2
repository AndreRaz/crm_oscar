<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Informe de inspección {{ inspection.id }}</title>
  <style>
    @page { size: A4; margin: 16mm; }
    body { color: #20242a; font: 10pt sans-serif; }
    header { display: flex; justify-content: space-between; }
    img { max-height: 42mm; max-width: 75mm; object-fit: contain; }
    table { border-collapse: collapse; margin-top: 8mm; width: 100%; }
    th, td { border: 1px solid #777; padding: 4px; text-align: left; }
    th { background: #e9ecef; }
    .status { font-weight: bold; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1>Informe de inspección</h1>
      <p><strong>Tipo de pieza:</strong> {{ part_type.code }}</p>
      <p><strong>Serie:</strong> {{ piece.serial }}</p>
      <p><strong>Inspector:</strong> {{ inspector.username }}</p>
      <p><strong>Fecha/hora:</strong> {{ report_at.isoformat() }}</p>
      <p class="status"><strong>Estado general:</strong> {{ inspection.status.value }}</p>
    </div>
    {% if image_uri %}<img src="{{ image_uri }}" alt="Imagen de {{ part_type.code }}">{% endif %}
  </header>

  <table>
    <thead><tr>
      <th>Característica</th><th>Nominal</th><th>Tolerancia</th>
      <th>Actual</th><th>Desviación</th><th>Estado</th>
    </tr></thead>
    <tbody>
    {% for row in measurements %}
      <tr>
        <td>{{ row.code }}{% if row.name %} — {{ row.name }}{% endif %}{% if row.unit %} ({{ row.unit }}){% endif %}</td>
        <td>{{ row.nominal }}</td><td>{{ row.tolerance }}</td>
        <td>{{ row.actual }}</td><td>{{ row.deviation }}</td><td>{{ row.status }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  {% if disposition_notes %}
  <section id="dispositions">
    <h2>Notas de disposición</h2>
    {% for row in disposition_notes %}<p><strong>{{ row.code }}:</strong> {{ row.note }}</p>{% endfor %}
  </section>
  {% endif %}
</body>
</html>
